<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MoTask.App</RootNamespace>
    <AssemblyName>MoTask</AssemblyName>
    <ApplicationIcon>..\..\resources\motodo_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!--
    発行時だけ ReadyToRun で事前コンパイルし、起動時の JIT を減らす（初回描画まで約 0.7 秒短くなった）。
    ReadyToRun には RID が要るが、dotnet publish -r で渡すと参照先（Hooks / Mcp）にも伝わって
    出力先が win-x64\ にずれ、下の hooks\ / mcp\ のコピーが壊れる。ここで指定すれば伝わらない。
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoTask.Core\MoTask.Core.csproj" />
    <ProjectReference Include="..\MoTask.Data\MoTask.Data.csproj" />
    <!-- フックの exe。参照はビルド順のためだけで、アセンブリとしては使わない。 -->
    <ProjectReference Include="..\MoTask.Hooks\MoTask.Hooks.csproj" ReferenceOutputAssembly="false" />
    <!-- MCP ブリッジの exe。参照はビルド順のためだけで、アセンブリとしては使わない。 -->
    <!-- _IsPublishing を渡すと、Mcp 側の発行時設定（RID）が効いて出力先が win-x64\ にずれる。 -->
    <ProjectReference Include="..\MoTask.Mcp\MoTask.Mcp.csproj" ReferenceOutputAssembly="false"
                      UndefineProperties="_IsPublishing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MoTask.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\resources\motodo_icon.ico" Link="Resources\motodo_icon.ico" />
    <Resource Include="Fonts\*.ttf" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Strings.resx sits next to Strings.cs with the same base name, so MSBuild's
         dependent-file detection would otherwise derive the manifest name from the .cs
         file instead of the folder. Pin it to the ResourceManager base name in Strings.cs. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>MoTask.App.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!--
      hooks\ に実体を運ぶ。Content にしておくと MoTask.App を参照するプロジェクト
      （App.Tests）の出力にも同じ相対位置で並ぶので、テストから実起動できる。
      上の ProjectReference がビルド順を保証するので、コピー時には必ず存在する。
      MoTask.Hooks は net10.0 固定・出力パスも既定なので、パスを直に書いてよい。
    -->
    <Content Include="..\MoTask.Hooks\bin\$(Configuration)\net10.0\MoTask.Hooks.exe"
             Link="hooks\MoTask.Hooks.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\MoTask.Hooks\bin\$(Configuration)\net10.0\MoTask.Hooks.dll"
             Link="hooks\MoTask.Hooks.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\MoTask.Hooks\bin\$(Configuration)\net10.0\MoTask.Hooks.runtimeconfig.json"
             Link="hooks\MoTask.Hooks.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!--
      mcp\ に実体を運ぶ。MoTask.Mcp は MoTask.Core.dll を必要とするが、それはこのプロジェクトの
      出力ルートに既にある。ブリッジは出力ルートではなく mcp\ に置かれるので、MoTask.Core.dll も
      並べる必要がある。MoTask.Mcp も net10.0 固定・出力パスも既定なので、パスを直に書いてよい。
    -->
    <Content Include="..\MoTask.Mcp\bin\$(Configuration)\net10.0\MoTask.Mcp.exe"
             Link="mcp\MoTask.Mcp.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\MoTask.Mcp\bin\$(Configuration)\net10.0\MoTask.Mcp.dll"
             Link="mcp\MoTask.Mcp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\MoTask.Mcp\bin\$(Configuration)\net10.0\MoTask.Mcp.runtimeconfig.json"
             Link="mcp\MoTask.Mcp.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\MoTask.Mcp\bin\$(Configuration)\net10.0\MoTask.Core.dll"
             Link="mcp\MoTask.Core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
