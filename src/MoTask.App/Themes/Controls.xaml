<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MoTask.App.Converters">

  <!-- 標準コントロール（Button / TextBox / ComboBox / CheckBox / DatePicker / ScrollBar / 右クリックメニュー）の
       見た目は WPF 同梱の Fluent テーマ（App.xaml の ThemeMode）に任せる。ここに置くのはアプリ固有の部品だけ。
       色は必ず Fluent のキーを DynamicResource で引く。StaticResource だと OS のテーマ切り替えに追従しない。 -->

  <conv:RampBrushConverter x:Key="RampBrush" />
  <conv:DueStatusBrushConverter x:Key="DueStatusBrush" />
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

  <!-- 文字 -->
  <Style x:Key="Text.Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.H5}" />
  </Style>
  <Style x:Key="Text.Brand" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.H4}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <!-- 本文の段。サイズ無指定で Window の既定を拾わせると、周りの操作系より大きく出て
       しまうので、本文として置く文字にはこれを明示する。 -->
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="Text.Small" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- 折り返す前提の段。行送りを明示するのはここだけにする。Text.Small / Text.Caption 側に
       LineHeight を入れると、カードのバッジや列見出しのような単一行の要素まで背が伸びる。 -->
  <Style x:Key="Text.Prose" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Small}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- セクション見出し。フィールドのラベル（Text.Label = 12px muted のメタ表記）と
       同じ見た目にすると、パネルが延々と続く一列に見えて構造が読めない。
       上に区切り線を敷き、色と太さで「塊の始まり」だと分かるようにする。 -->
  <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="Section.Header" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Margin" Value="{StaticResource Gap.Section}" />
    <Setter Property="Padding" Value="{StaticResource Pad.SectionHeader}" />
  </Style>

  <!-- 唯一の塗りあり: primary。塗り・ホバー・押下の色は Fluent のアクセントボタンが持つ。 -->
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />

  <!-- 枠も塗りも無いボタン（Windows 11 のサブトルボタン）。ホバーで薄い面を敷く。
       Fluent の Button はホバー時の地をテンプレート側で決めていて透明にできないので、専用のテンプレートを持つ。
       状態色は ControlTemplate.Triggers ではなく Style.Triggers に置く。こうすると Btn.Link が
       同じテンプレートを BasedOn で受け継いだまま、状態色だけ差し替えられる。 -->
  <Style x:Key="Btn.Ghost" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6.8,3.4" />
    <!-- 中身の寄せは既定で中央。テンプレート側で固定せずここに置くことで、
         行全体が押せるボタンは Stretch に上書きして左端寄せにできる。 -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 画面切り替えタブ（ボード / 計画）。Windows 11 の SelectorBar と同じく、選択中は文字の下中央に
       短い角丸のアクセント線を出す。選択中かどうかは Tag="Active" で渡す（コード側から色を直接当てると
       局所値になり、ホバーなどのトリガが効かなくなる）。 -->
  <Style x:Key="Btn.Tab" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
    <Setter Property="Padding" Value="{StaticResource Pad.Tab}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <Border x:Name="Indicator" Grid.Row="1" Width="16" Height="3" CornerRadius="1.5"
                    HorizontalAlignment="Center" Background="Transparent" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
      <Trigger Property="Tag" Value="Active">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 枠も塗りも無いまま「押せる」ことを色で示すボタン。Btn.Ghost は控えめな文字色なので、
       同じ色のラベル（Text.Caption 系）と見分けが付かない。開く・たどる操作はこちらを使う。 -->
  <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    <!-- 左パディングを落として、文字の左端をラベルや枠付きボタンの箱の左端に揃える。
         枠も塗りも無いので、ホバーは背景ではなく色の変化だけで示す。 -->
    <Setter Property="Padding" Value="0,3.4" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ラベル／フィルタ用チップ -->
  <Style x:Key="Chip.Toggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                  Padding="6.8,2" CornerRadius="12" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ラベル絞り込みのポップアップに並べるチップ。DataContext は LabelFilterItem。
       選ぶ前は色の丸と名前だけ、選ぶとラベル自身の色で塗りつぶして丸を ✓ に替える（塗りはカードのラベルと同じ）。
       文字色と ✓ の色は、段の濃さから選んだ TextColor を使う。ラベルの色はテーマに関係なく固定。 -->
  <Style x:Key="Chip.Label" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                  Padding="8,3,10,3" CornerRadius="12" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <Grid Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource RampBrush}}" />
                <Path x:Name="Check" Visibility="Collapsed" Data="M 1,5 L 4,8 L 9,2" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding TextColor, Converter={StaticResource RampBrush}}" />
              </Grid>
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            </Trigger>
            <!-- ホバーより後に置き、選択中はホバーでも塗りを保つ -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{Binding Color, Converter={StaticResource RampBrush}}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Color, Converter={StaticResource RampBrush}}" />
              <Setter Property="Foreground" Value="{Binding TextColor, Converter={StaticResource RampBrush}}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ポップアップを開くフィルタバーのボタン。隣に並ぶ Fluent の ComboBox と同じ地・枠・下向き記号にそろえる。 -->
  <Style x:Key="Btn.Dropdown" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Padding" Value="10,5,0,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
              <!-- U+E70D = ChevronDown（Segoe Fluent Icons）。Fluent の ComboBox と同じ記号。 -->
              <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 右クリックメニューとツールチップは別ウィンドウとして開くので、Window の書体を引き継がない。
       見た目は Fluent のまま、書体だけを指定し直す。 -->
  <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
  </Style>
</ResourceDictionary>
