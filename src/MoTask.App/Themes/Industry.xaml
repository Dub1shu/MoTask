<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Graphite Blue: 黒の濃淡で階層を作り、操作箇所だけ青で強調する。 -->
  <Color x:Key="Color.Bg">#0D0F12</Color>
  <Color x:Key="Color.Surface">#15181D</Color>
  <Color x:Key="Color.SurfaceRaised">#1D2128</Color>
  <Color x:Key="Color.SurfaceHover">#252B35</Color>
  <Color x:Key="Color.Input">#111419</Color>
  <Color x:Key="Color.Text">#ECEEF2</Color>
  <Color x:Key="Color.TextMuted">#9BA3B2</Color>
  <Color x:Key="Color.Accent">#7DA7FF</Color>
  <Color x:Key="Color.AccentSubtle">#263756</Color>
  <Color x:Key="Color.Divider">#343943</Color>
  <Color x:Key="Color.Danger">#FF7373</Color>
  <Color x:Key="Color.OnAccent">#0C1424</Color>

  <Color x:Key="Color.Neutral.100">#F5F5F8</Color>
  <Color x:Key="Color.Neutral.200">#E7E7EA</Color>
  <Color x:Key="Color.Neutral.300">#D4D4D7</Color>
  <Color x:Key="Color.Neutral.400">#B7B7BA</Color>
  <Color x:Key="Color.Neutral.500">#98989B</Color>
  <Color x:Key="Color.Neutral.600">#7A7A7D</Color>
  <Color x:Key="Color.Neutral.700">#5D5D60</Color>
  <Color x:Key="Color.Neutral.800">#424244</Color>
  <Color x:Key="Color.Neutral.900">#2B2B2D</Color>

  <Color x:Key="Color.Accent.100">#EEF6FF</Color>
  <Color x:Key="Color.Accent.200">#D6EBFF</Color>
  <Color x:Key="Color.Accent.300">#B5D9FD</Color>
  <Color x:Key="Color.Accent.400">#94BCE3</Color>
  <Color x:Key="Color.Accent.500">#749DC4</Color>
  <Color x:Key="Color.Accent.600">#597EA3</Color>
  <Color x:Key="Color.Accent.700">#416180</Color>
  <Color x:Key="Color.Accent.800">#2C455D</Color>
  <Color x:Key="Color.Accent.900">#1D2D3D</Color>

  <!-- ラベルの見本（LabelPalette）だけが使う色相。明るさは accent-300 / accent-600 にそろえ、使う段だけを置く -->
  <Color x:Key="Color.Red.300">#F5B8B8</Color>
  <Color x:Key="Color.Red.600">#A35959</Color>
  <Color x:Key="Color.Orange.300">#F8CBA6</Color>
  <Color x:Key="Color.Orange.600">#A3734A</Color>
  <Color x:Key="Color.Yellow.300">#F1DF9E</Color>
  <Color x:Key="Color.Yellow.600">#998433</Color>
  <Color x:Key="Color.Green.300">#B8E0B5</Color>
  <Color x:Key="Color.Green.600">#5C8F59</Color>
  <Color x:Key="Color.Teal.300">#A8DDD6</Color>
  <Color x:Key="Color.Teal.600">#4E8C84</Color>
  <Color x:Key="Color.Purple.300">#D3C2F5</Color>
  <Color x:Key="Color.Purple.600">#7A64A8</Color>
  <Color x:Key="Color.Pink.300">#F4BFD9</Color>
  <Color x:Key="Color.Pink.600">#A35C80</Color>

  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
  <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />

  <SolidColorBrush x:Key="Brush.Neutral.100" Color="{StaticResource Color.Neutral.100}" />
  <SolidColorBrush x:Key="Brush.Neutral.200" Color="{StaticResource Color.Neutral.200}" />
  <SolidColorBrush x:Key="Brush.Neutral.300" Color="{StaticResource Color.Neutral.300}" />
  <SolidColorBrush x:Key="Brush.Neutral.400" Color="{StaticResource Color.Neutral.400}" />
  <SolidColorBrush x:Key="Brush.Neutral.500" Color="{StaticResource Color.Neutral.500}" />
  <SolidColorBrush x:Key="Brush.Neutral.600" Color="{StaticResource Color.Neutral.600}" />
  <SolidColorBrush x:Key="Brush.Neutral.700" Color="{StaticResource Color.Neutral.700}" />
  <SolidColorBrush x:Key="Brush.Neutral.800" Color="{StaticResource Color.Neutral.800}" />
  <SolidColorBrush x:Key="Brush.Neutral.900" Color="{StaticResource Color.Neutral.900}" />

  <SolidColorBrush x:Key="Brush.Accent.100" Color="{StaticResource Color.Accent.100}" />
  <SolidColorBrush x:Key="Brush.Accent.200" Color="{StaticResource Color.Accent.200}" />
  <SolidColorBrush x:Key="Brush.Accent.300" Color="{StaticResource Color.Accent.300}" />
  <SolidColorBrush x:Key="Brush.Accent.400" Color="{StaticResource Color.Accent.400}" />
  <SolidColorBrush x:Key="Brush.Accent.500" Color="{StaticResource Color.Accent.500}" />
  <SolidColorBrush x:Key="Brush.Accent.600" Color="{StaticResource Color.Accent.600}" />
  <SolidColorBrush x:Key="Brush.Accent.700" Color="{StaticResource Color.Accent.700}" />
  <SolidColorBrush x:Key="Brush.Accent.800" Color="{StaticResource Color.Accent.800}" />
  <SolidColorBrush x:Key="Brush.Accent.900" Color="{StaticResource Color.Accent.900}" />

  <SolidColorBrush x:Key="Brush.Red.300" Color="{StaticResource Color.Red.300}" />
  <SolidColorBrush x:Key="Brush.Red.600" Color="{StaticResource Color.Red.600}" />
  <SolidColorBrush x:Key="Brush.Orange.300" Color="{StaticResource Color.Orange.300}" />
  <SolidColorBrush x:Key="Brush.Orange.600" Color="{StaticResource Color.Orange.600}" />
  <SolidColorBrush x:Key="Brush.Yellow.300" Color="{StaticResource Color.Yellow.300}" />
  <SolidColorBrush x:Key="Brush.Yellow.600" Color="{StaticResource Color.Yellow.600}" />
  <SolidColorBrush x:Key="Brush.Green.300" Color="{StaticResource Color.Green.300}" />
  <SolidColorBrush x:Key="Brush.Green.600" Color="{StaticResource Color.Green.600}" />
  <SolidColorBrush x:Key="Brush.Teal.300" Color="{StaticResource Color.Teal.300}" />
  <SolidColorBrush x:Key="Brush.Teal.600" Color="{StaticResource Color.Teal.600}" />
  <SolidColorBrush x:Key="Brush.Purple.300" Color="{StaticResource Color.Purple.300}" />
  <SolidColorBrush x:Key="Brush.Purple.600" Color="{StaticResource Color.Purple.600}" />
  <SolidColorBrush x:Key="Brush.Pink.300" Color="{StaticResource Color.Pink.300}" />
  <SolidColorBrush x:Key="Brush.Pink.600" Color="{StaticResource Color.Pink.600}" />

  <!-- 間隔（styles.css の space トークン） -->
  <sys:Double x:Key="Space.1">3.4</sys:Double>
  <sys:Double x:Key="Space.2">6.8</sys:Double>
  <sys:Double x:Key="Space.3">10.2</sys:Double>
  <sys:Double x:Key="Space.4">13.6</sys:Double>
  <sys:Double x:Key="Space.6">20.4</sys:Double>
  <sys:Double x:Key="Space.8">27.2</sys:Double>

  <!-- 余白（Thickness）。XAML は Double をそのまま Margin/Padding へ代入できないので、
       上の Space トークンから組んだ Thickness をここで名前付きにしておく。
       View 側は数値を書かず、このキーを参照する。 -->
  <Thickness x:Key="Pad.Bar" Left="{StaticResource Space.6}" Top="{StaticResource Space.3}"
             Right="{StaticResource Space.6}" Bottom="{StaticResource Space.3}" />
  <Thickness x:Key="Pad.BarTight" Left="{StaticResource Space.6}" Top="{StaticResource Space.2}"
             Right="{StaticResource Space.6}" Bottom="{StaticResource Space.2}" />
  <Thickness x:Key="Pad.Board" Left="{StaticResource Space.6}" Top="{StaticResource Space.4}"
             Right="{StaticResource Space.6}" Bottom="{StaticResource Space.4}" />
  <Thickness x:Key="Pad.Section" Left="{StaticResource Space.3}" Top="{StaticResource Space.2}"
             Right="{StaticResource Space.3}" Bottom="{StaticResource Space.2}" />
  <Thickness x:Key="Pad.Box" Left="{StaticResource Space.3}" Top="{StaticResource Space.3}"
             Right="{StaticResource Space.3}" Bottom="{StaticResource Space.3}" />
  <Thickness x:Key="Pad.Tab" Left="{StaticResource Space.2}" Top="{StaticResource Space.1}"
             Right="{StaticResource Space.2}" Bottom="{StaticResource Space.1}" />
  <!-- チップの内側。縦の 1 は実寸: Space.1 まで開けると行の高さが膨らむ。 -->
  <Thickness x:Key="Pad.Chip" Left="{StaticResource Space.1}" Top="1"
             Right="{StaticResource Space.1}" Bottom="1" />

  <!-- カード枠の内側。枠線の太さが変わっても内容の位置が動かないよう Pad.Box を ±1 で打ち消す。
       選択中は枠が 1→2px なので 10.2-1、削除済みは枠が 1→0px なので 10.2+1。 -->
  <Thickness x:Key="Pad.Card.Selected">9.2</Thickness>
  <Thickness x:Key="Pad.Card.Deleted">11.2</Thickness>

  <!-- 要素どうしの間隔。方向と Space の段で名前を付ける。 -->
  <Thickness x:Key="Gap.Left.1" Left="{StaticResource Space.1}" />
  <Thickness x:Key="Gap.Left.2" Left="{StaticResource Space.2}" />
  <Thickness x:Key="Gap.Left.3" Left="{StaticResource Space.3}" />
  <Thickness x:Key="Gap.Left.4" Left="{StaticResource Space.4}" />
  <Thickness x:Key="Gap.Left.8" Left="{StaticResource Space.8}" />
  <Thickness x:Key="Gap.Right.1" Right="{StaticResource Space.1}" />
  <Thickness x:Key="Gap.Right.4" Right="{StaticResource Space.4}" />
  <Thickness x:Key="Gap.Top.1" Top="{StaticResource Space.1}" />
  <Thickness x:Key="Gap.Top.2" Top="{StaticResource Space.2}" />
  <Thickness x:Key="Gap.Top.4" Top="{StaticResource Space.4}" />
  <Thickness x:Key="Gap.Bottom.1" Bottom="{StaticResource Space.1}" />
  <Thickness x:Key="Gap.Bottom.2" Bottom="{StaticResource Space.2}" />
  <Thickness x:Key="Gap.Chip" Right="{StaticResource Space.1}" Bottom="{StaticResource Space.1}" />
  <!-- 詳細パネルのフィールドラベル: 前の項目との間を広め、直後の入力欄との間を詰める。 -->
  <Thickness x:Key="Gap.FieldLabel" Top="{StaticResource Space.4}" Bottom="{StaticResource Space.1}" />
  <!-- 詳細パネルのセクション見出し: 前のセクションとの間を大きく開け、区切り線と文字の間を詰める。 -->
  <Thickness x:Key="Gap.Section" Top="{StaticResource Space.6}" />
  <Thickness x:Key="Pad.SectionHeader" Top="{StaticResource Space.3}" Bottom="{StaticResource Space.1}" />
  <!-- WrapPanel に並べるボタン。折り返した 2 行目が密着しないよう、右だけでなく下にも開ける。 -->
  <Thickness x:Key="Gap.Action" Right="{StaticResource Space.4}" Bottom="{StaticResource Space.2}" />

  <!-- 列の幅。列本体と「＋ 列を追加」の箱で揃える。 -->
  <sys:Double x:Key="Size.Column">280</sys:Double>

  <!-- 見出し・本文ともに Yu Gothic UI に統一する。 -->
  <FontFamily x:Key="Font.Heading">Yu Gothic UI</FontFamily>
  <FontFamily x:Key="Font.Body">Yu Gothic UI</FontFamily>
  <!-- 字の大きさは 4 段だけにする。役割で段を分け、隣り合う段の差は必ず 2px 以上とる。
       12=メタ（フィールドのラベル・補足文・時刻）
       13=副次本文（ログ・履歴・チップ）
       15=本文と操作（入力欄・ボタン・コンボ）
       18=詳細のタイトル
       以前あった 14（FontSize.Control）は 15 と見分けが付かず、階層ではなく不揃いにしか
       見えなかったので Body に統合して廃止した。 -->
  <sys:Double x:Key="FontSize.Body">15</sys:Double>
  <sys:Double x:Key="FontSize.Small">13</sys:Double>
  <sys:Double x:Key="FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="FontSize.DetailTitle">18</sys:Double>
  <sys:Double x:Key="FontSize.H4">20</sys:Double>
  <sys:Double x:Key="FontSize.H5">16</sys:Double>

  <!-- 行送り。Yu Gothic UI の設計行間は 1.1em 前後しかなく、折り返す和文が潰れて読めない。
       段ごとに実寸で 1.5 倍前後を明示する。単一行の要素まで背が伸びないよう、
       これを当てるのは折り返す前提のスタイル（Text.Prose / Text.Hint / Text.Body）だけ。 -->
  <sys:Double x:Key="LineHeight.Body">22</sys:Double>
  <sys:Double x:Key="LineHeight.Small">20</sys:Double>
  <sys:Double x:Key="LineHeight.Caption">18</sys:Double>
</ResourceDictionary>
