<UserControl x:Class="MoTask.App.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MoTask.App.Resources"
             xmlns:vm="clr-namespace:MoTask.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ArchiveViewModel}">
  <DockPanel Margin="{StaticResource Pad.Board}">

    <!-- 読み込みの失敗。PlanView のバナーと同じ形。 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="0,0,0,1"
            Padding="{StaticResource Pad.BarTight}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" ToolTip="{x:Static res:Strings.Close}"
                Style="{StaticResource Btn.Ghost}" Command="{Binding DismissBannerCommand}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.ArchiveEmpty}" Style="{StaticResource Text.Caption}"
               Margin="{StaticResource Gap.Top.4}"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <!-- 左: 週ごとの一覧。行は PlanView の行と同じく既定の Button（塗りと枠で行の境界を示す）。 -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Weeks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="{StaticResource Gap.Top.4}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Label}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Padding="{StaticResource Pad.Box}" Margin="{StaticResource Gap.Top.2}">
                        <Button.Style>
                          <!-- 選んでいる行は枠をアクセント色にする。既定の Button スタイルを土台にする。 -->
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CompletedOnText}"
                                     Style="{StaticResource Text.Caption}" VerticalAlignment="Top"
                                     Margin="{StaticResource Gap.Left.2}" />
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ProjectName, Converter={StaticResource NullToVisibility}}">
                              <!-- 色なしのプロジェクトは丸を出さない -->
                              <Ellipse Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Fill="{Binding ProjectColor, Converter={StaticResource RampBrush}}"
                                       Visibility="{Binding ProjectColor, Converter={StaticResource NullToVisibility}}" />
                              <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                          </StackPanel>
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 右: 読み取り専用の詳細。ボードの TaskDetailPanel は編集用なので使い回さない。 -->
      <Border Grid.Column="1" Margin="{StaticResource Gap.Left.4}"
              Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="{StaticResource Pad.Box}"
              Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel DataContext="{Binding SelectedItem}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />

            <TextBlock Text="{x:Static res:Strings.CompletedAt}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.4}" />
            <TextBlock Text="{Binding CompletedAtText}" />
            <TextBlock Text="{x:Static res:Strings.CreatedAt}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.2}" />
            <TextBlock Text="{Binding CreatedAtText}" />

            <StackPanel Visibility="{Binding ProjectName, Converter={StaticResource NullToVisibility}}">
              <TextBlock Text="{x:Static res:Strings.FieldProject}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.2}" />
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                         Fill="{Binding ProjectColor, Converter={StaticResource RampBrush}}"
                         Visibility="{Binding ProjectColor, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding ProjectName}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{x:Static res:Strings.FieldLabels}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.2}" />
              <ItemsControl ItemsSource="{Binding Labels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- カードのラベルと同じ見た目（文字色は段の濃さから選んだ TextColor）。 -->
                    <Border Background="{Binding Color, Converter={StaticResource RampBrush}}" CornerRadius="3"
                            Padding="{StaticResource Pad.Chip}" Margin="{StaticResource Gap.Chip}">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}"
                                 Foreground="{Binding TextColor, Converter={StaticResource RampBrush}}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{x:Static res:Strings.Description}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.4}" />
              <!-- 文字を選んでコピーできるよう、読み取り専用の TextBox で出す。 -->
              <TextBox Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                       Margin="{StaticResource Gap.Top.1}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
