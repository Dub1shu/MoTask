<UserControl x:Class="MoTask.App.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:be="clr-namespace:MoTask.App.Behaviors"
             xmlns:dd="clr-namespace:MoTask.App.DragDrop"
             xmlns:res="clr-namespace:MoTask.App.Resources"
             xmlns:vm="clr-namespace:MoTask.App.ViewModels"
             xmlns:views="clr-namespace:MoTask.App.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BoardViewModel}">
  <!-- 縦を止めている ScrollViewer は WPF 標準だとホイールが死ぬので、横へ読み替える口を付ける。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="{StaticResource Pad.Board}"
                be:HorizontalWheelScroll.IsEnabled="True">
    <StackPanel Orientation="Horizontal">
      <!-- 列の並び替えの受け皿。DropHandler はコードビハインドで挿す。 -->
      <ItemsControl x:Name="ColumnsHost" ItemsSource="{Binding Columns}" dd:DragDropBehavior.IsDropTarget="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:ColumnView Margin="{StaticResource Gap.Right.4}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 列を追加 -->
      <Border Width="{StaticResource Size.Column}" VerticalAlignment="Top" Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"
              Padding="{StaticResource Pad.Box}">
        <Grid>
          <Button Content="{x:Static res:Strings.AddColumn}" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                  Command="{Binding BeginAddColumnCommand}"
                  Visibility="{Binding IsAddingColumn, Converter={StaticResource BoolToVisibilityInverse}}" />
          <!-- 名前だけを聞く（役割は列メニューで変える）。Enter で確定、Esc で取り消し。 -->
          <TextBox Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsAddingColumn, Converter={StaticResource BoolToVisibility}}"
                   KeyDown="NewColumnEditor_KeyDown" IsVisibleChanged="EditBox_IsVisibleChanged" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
