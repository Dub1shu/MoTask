<UserControl x:Class="MoTask.App.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:res="clr-namespace:MoTask.App.Resources"
             xmlns:vm="clr-namespace:MoTask.App.ViewModels"
             xmlns:views="clr-namespace:MoTask.App.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BoardViewModel}">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="{StaticResource Pad.Board}">
    <StackPanel Orientation="Horizontal">
      <!-- 列の並び替えの受け皿。DropHandler はコードビハインドで挿す。 -->
      <ItemsControl x:Name="ColumnsHost" ItemsSource="{Binding Columns}" dd:DragDrop.IsDropTarget="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:ColumnView Margin="{StaticResource Gap.Right.4}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 列を追加 -->
      <Border Width="{StaticResource Size.Column}" VerticalAlignment="Top" Background="{StaticResource Brush.Surface}"
              BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="10"
              Padding="{StaticResource Pad.Box}">
        <Grid>
          <Button Content="{x:Static res:Strings.AddColumn}" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                  Command="{Binding BeginAddColumnCommand}"
                  Visibility="{Binding IsAddingColumn, Converter={StaticResource BoolToVisibilityInverse}}" />
          <!-- 名前と種別。Enter で確定、Esc で取り消し（どちらの入力欄からでも効くよう親で受ける）。 -->
          <StackPanel Visibility="{Binding IsAddingColumn, Converter={StaticResource BoolToVisibility}}"
                      KeyDown="NewColumnEditor_KeyDown">
            <TextBox Text="{Binding NewColumnName, UpdateSourceTrigger=PropertyChanged}"
                     IsVisibleChanged="EditBox_IsVisibleChanged" />
            <!-- 種別は列を追加するときに決める。完了列は1つだけなので選べない（仕様 §5）。 -->
            <ComboBox Margin="{StaticResource Gap.Top.2}" ItemsSource="{Binding NewColumnRoles}" DisplayMemberPath="Name"
                      SelectedItem="{Binding NewColumnRole}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
