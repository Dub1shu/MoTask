<Window x:Class="MoTask.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:MoTask.App.Resources"
        xmlns:vm="clr-namespace:MoTask.App.ViewModels"
        xmlns:views="clr-namespace:MoTask.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BoardViewModel}"
        Title="{x:Static res:Strings.AppTitle}" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Icon="/Resources/motodo_icon.ico"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource FontSize.Body}"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
  <DockPanel>
    <!-- アプリの基準面。黒の濃淡と細い境界線でボードから分離する。 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
            Padding="{StaticResource Pad.Bar}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" VerticalAlignment="Center"
                Content="{x:Static res:Strings.AiSettings}" Click="OnAiSettingsClick" Margin="{StaticResource Gap.Left.2}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" VerticalAlignment="Center"
                Content="{x:Static res:Strings.ManageClassifications}" Click="OnManageClassificationsClick" />
        <StackPanel Orientation="Horizontal">
          <!-- どれが今の画面かは Click ハンドラ側(ShowView)が Tag を切り替えて示す。
               下線と文字色そのものは Btn.Tab スタイルが持つ。 -->
          <Button x:Name="BoardTabButton" Style="{StaticResource Btn.Tab}" Click="OnShowBoardClick">
            <TextBlock Text="{x:Static res:Strings.ViewBoard}" FontWeight="Medium" />
          </Button>
          <Button x:Name="PlanTabButton" Style="{StaticResource Btn.Tab}" Click="OnShowPlanClick"
                  Margin="{StaticResource Gap.Left.2}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static res:Strings.ViewPlan}" FontWeight="Medium" VerticalAlignment="Center" />
              <!-- 候補件数のバッジ（ワイヤー 4c）。同じ画面への導線を 2 つ作らず、タブに付ける（仕様 §3） -->
              <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="{StaticResource Pad.Chip}"
                      Margin="{StaticResource Gap.Left.1}" VerticalAlignment="Center"
                      Visibility="{Binding DataContext.HasPendingCandidates, ElementName=PlanHost, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding DataContext.PendingCount, ElementName=PlanHost}"
                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="ArchiveTabButton" Style="{StaticResource Btn.Tab}" Click="OnShowArchiveClick"
                  Margin="{StaticResource Gap.Left.2}">
            <TextBlock Text="{x:Static res:Strings.ViewArchive}" FontWeight="Medium" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 保存失敗などの非モーダルバナー -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleFillColorTertiaryBrush}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
            BorderThickness="0,0,0,1" Padding="{StaticResource Pad.BarTight}"
            Visibility="{Binding BannerMessage, Converter={StaticResource NullToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" ToolTip="{x:Static res:Strings.Close}"
                Style="{StaticResource Btn.Ghost}" Command="{Binding DismissBannerCommand}" />
        <TextBlock Text="{Binding BannerMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <views:FilterBar x:Name="FilterBar" DockPanel.Dock="Top" />

    <Grid>
      <Grid x:Name="BoardHost">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:BoardView Grid.Column="0" />
        <views:TaskDetailPanel Grid.Column="1" Width="360" DataContext="{Binding Detail}"
                               Visibility="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}" />
      </Grid>
      <views:PlanView x:Name="PlanHost" Visibility="Collapsed" />
      <views:ArchiveView x:Name="ArchiveHost" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</Window>
