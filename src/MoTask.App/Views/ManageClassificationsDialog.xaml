<Window x:Class="MoTask.App.Views.ManageClassificationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:MoTask.App.Resources"
        xmlns:vm="clr-namespace:MoTask.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ManageClassificationsViewModel}"
        Title="{x:Static res:Strings.ManageClassifications}" Width="480" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource FontSize.Body}"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="Manage.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="{StaticResource Gap.FieldLabel}" />
    </Style>

    <!-- 色丸のボタン。Btn.Ghost は Button 用、Btn.Dropdown は矢印が付くので、ここだけの最小の見た目を持つ -->
    <Style x:Key="Manage.ColorDot" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="3">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 1行分。ClassificationRow は種別を持つので、プロジェクトとラベルで同じテンプレートを使える。 -->
    <DataTemplate x:Key="Manage.Row">
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
              Padding="{StaticResource Pad.BarTight}">
        <DockPanel>
          <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                <Setter Property="Content" Value="{x:Static res:Strings.ManageArchive}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsArchived}" Value="True">
                    <Setter Property="Content" Value="{x:Static res:Strings.ManageUnarchive}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>

          <!-- 色丸：押すと見本のポップアップ。色なしのプロジェクトは枠線だけの丸 -->
          <Grid DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,6,0">
            <ToggleButton x:Name="ColorDot" ToolTip="{x:Static res:Strings.ManageChangeColor}">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource Manage.ColorDot}">
                  <Style.Triggers>
                    <!-- StaysOpen=False は外側のクリックで閉じた直後に、そのクリックで ToggleButton が開き直す。
                         開いている間は色丸がクリックを受けないようにして、色丸のクリックで閉じられるようにする -->
                    <DataTrigger Binding="{Binding IsOpen, ElementName=ColorPopup}" Value="True">
                      <Setter Property="IsHitTestVisible" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
              <Ellipse Width="12" Height="12">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{Binding Color, Converter={StaticResource RampBrush}}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Color}" Value="{x:Null}">
                        <Setter Property="Fill" Value="Transparent" />
                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Setter Property="StrokeThickness" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
            </ToggleButton>
            <Popup x:Name="ColorPopup" IsOpen="{Binding IsChecked, ElementName=ColorDot}" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ColorDot}" Placement="Bottom" AllowsTransparency="True">
              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="6">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Swatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="9" Rows="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Popup の中は別のビジュアルツリーで、AncestorType=Window が引けない。コマンドはコードビハインドから呼ぶ -->
                        <Button Margin="2" Padding="0" Cursor="Hand" Style="{StaticResource Btn.Ghost}"
                                ToolTip="{Binding Color}" Click="OnSwatchClick">
                          <Border x:Name="Ring" Width="22" Height="22" CornerRadius="11" BorderThickness="2"
                                  BorderBrush="Transparent" Padding="2">
                            <Ellipse Fill="{Binding Color, Converter={StaticResource RampBrush}}" />
                          </Border>
                        </Button>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- プロジェクトだけ：既定の「色なし」へ戻す。DataContext は NoColorSwatch なので、見本と同じ Click で扱える -->
                  <Button DataContext="{Binding NoColorSwatch}" Content="{x:Static res:Strings.ManageNoColor}"
                          HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnSwatchClick"
                          Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <StackPanel>
            <!-- 名前：普段は文字、クリックで TextBox -->
            <Grid>
              <Border Cursor="Hand" Padding="2,0" CornerRadius="3" HorizontalAlignment="Left"
                      ToolTip="{x:Static res:Strings.ManageRenameHint}" MouseLeftButtonUp="OnNameClick"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityInverse}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <!-- Transparent でないとクリックが文字の隙間を素通りする。ローカル値にするとトリガーが効かないので Setter で置く -->
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <!-- アーカイブ済みは淡くして、生きている行と見分けが付くようにする -->
                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                       KeyDown="OnRenameBoxKeyDown" LostFocus="OnRenameBoxLostFocus"
                       IsVisibleChanged="OnEditBoxIsVisibleChanged" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
              <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{x:Static res:Strings.ManageArchivedNote}" Style="{StaticResource Text.Caption}"
                         Margin="{StaticResource Gap.Left.2}"
                         Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- 空のときだけ出す「まだありません」 -->
    <Style x:Key="Manage.Empty" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="{StaticResource Pad.BarTight}" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="{StaticResource Pad.Board}">
    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}"
            Content="{x:Static res:Strings.Close}" Margin="{StaticResource Gap.Top.4}" Click="OnCloseClick" />
    <!-- ダイアログはモーダルで裏のバナーが見えないので、失敗はここに出す -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
               Style="{StaticResource Text.Caption}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               Margin="{StaticResource Gap.Top.2}"
               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{x:Static res:Strings.ManageProjectsHeading}" Style="{StaticResource Manage.Heading}" />
        <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource Manage.Row}" />
        <TextBlock Text="{x:Static res:Strings.ManageEmpty}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Manage.Empty}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button Content="{x:Static res:Strings.ManageAddProject}" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                Margin="{StaticResource Gap.Top.2}" Command="{Binding BeginAddProjectCommand}"
                Visibility="{Binding IsAddingProject, Converter={StaticResource BoolToVisibilityInverse}}" />
        <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Gap.Top.2}"
                 Tag="Project" Visibility="{Binding IsAddingProject, Converter={StaticResource BoolToVisibility}}"
                 KeyDown="OnNewBoxKeyDown" LostFocus="OnNewBoxLostFocus" IsVisibleChanged="OnEditBoxIsVisibleChanged" />

        <TextBlock Text="{x:Static res:Strings.ManageLabelsHeading}" Style="{StaticResource Manage.Heading}" />
        <ItemsControl ItemsSource="{Binding Labels}" ItemTemplate="{StaticResource Manage.Row}" />
        <TextBlock Text="{x:Static res:Strings.ManageEmpty}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Manage.Empty}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Labels.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button Content="{x:Static res:Strings.ManageAddLabel}" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                Margin="{StaticResource Gap.Top.2}" Command="{Binding BeginAddLabelCommand}"
                Visibility="{Binding IsAddingLabel, Converter={StaticResource BoolToVisibilityInverse}}" />
        <TextBox Text="{Binding NewLabelName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Gap.Top.2}"
                 Tag="Label" Visibility="{Binding IsAddingLabel, Converter={StaticResource BoolToVisibility}}"
                 KeyDown="OnNewBoxKeyDown" LostFocus="OnNewBoxLostFocus" IsVisibleChanged="OnEditBoxIsVisibleChanged" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
