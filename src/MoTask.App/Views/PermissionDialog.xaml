<Window x:Class="MoTask.App.Views.PermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:MoTask.App.Resources"
        xmlns:vm="clr-namespace:MoTask.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PermissionDialogViewModel}"
        Title="{x:Static res:Strings.PermissionTitle}" Width="640" Height="520" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Topmost="True"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource FontSize.Body}">
  <Window.Resources>
    <Style x:Key="Permission.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="{StaticResource Gap.FieldLabel}" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="{StaticResource Pad.Board}">
    <!-- 4 つの選択肢。主ボタンは「許可」。 -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.Top.4}">
      <Button Content="{x:Static res:Strings.PermissionDenyAlways}" Command="{Binding DenyAlwaysCommand}" Margin="{StaticResource Gap.Right.4}" />
      <Button Content="{x:Static res:Strings.PermissionAllowAlways}" Command="{Binding AllowAlwaysCommand}" Margin="{StaticResource Gap.Right.4}" />
      <Button Content="{x:Static res:Strings.PermissionDeny}" Command="{Binding DenyCommand}" Margin="{StaticResource Gap.Right.4}" />
      <Button Content="{x:Static res:Strings.PermissionAllow}" Command="{Binding AllowCommand}" Style="{StaticResource Btn.Primary}" IsDefault="True" />
    </StackPanel>

    <!-- 「今後も」の条件とスコープ -->
    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource Gap.Top.2}">
      <TextBlock Text="{Binding RememberText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.1}"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
        <RadioButton Content="{x:Static res:Strings.PermissionScopeProject}" IsChecked="{Binding RememberForProject}" Margin="{StaticResource Gap.Right.4}" />
        <RadioButton Content="{x:Static res:Strings.PermissionScopeGlobal}" IsChecked="{Binding RememberForAll}" />
      </StackPanel>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="{Binding ToolLine}" Style="{StaticResource Text.Heading}" />
      <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="{StaticResource Gap.Top.2}"
               FontWeight="Medium" BorderThickness="0" Background="Transparent" />
      <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Gap.Top.2}"
               FontFamily="Consolas" />

      <TextBlock Text="{x:Static res:Strings.PermissionTask}" Style="{StaticResource Permission.Label}" />
      <TextBlock Text="{Binding TaskTitle}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Static res:Strings.PermissionWorkingDirectory}" Style="{StaticResource Permission.Label}" />
      <TextBlock Text="{Binding WorkingDirectory}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
