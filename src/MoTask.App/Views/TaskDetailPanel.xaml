<UserControl x:Class="MoTask.App.Views.TaskDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MoTask.App.Resources"
             xmlns:vm="clr-namespace:MoTask.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TaskDetailViewModel}">
  <UserControl.Resources>
    <!-- フィールドのラベルは Text.Label（12px muted）のまま、メタ表記の段に置く。
         かつて中身に負けて見えたのは大きさではなく、セクション見出しと同じ見た目で
         並んでいて構造が読めなかったせい。見出し側は Section.Header で描き分ける。 -->
    <Style x:Key="Field.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="{StaticResource Gap.FieldLabel}" />
    </Style>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1,0,0,0" Padding="{StaticResource Pad.Board}"
          Background="{StaticResource Brush.Surface}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top">
        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource Btn.Ghost}" Command="{Binding CloseCommand}"
                ToolTip="{x:Static res:Strings.Close}" />
        <TextBlock Text="{Binding SelectedColumn.Name}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      </DockPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="{StaticResource Gap.Top.4}">
        <Button Content="{x:Static res:Strings.Delete}" Command="{Binding DeleteCommand}"
                Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibilityInverse}}" />
        <Button Content="{x:Static res:Strings.Restore}" Style="{StaticResource Btn.Primary}" Command="{Binding RestoreCommand}"
                Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{x:Static res:Strings.Deleted}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Danger}" Margin="{StaticResource Gap.Left.3}"
                   VerticalAlignment="Center" Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- タイトル: フォーカスアウトで保存、Esc で取り消し -->
          <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource Gap.Top.2}"
                   FontFamily="{StaticResource Font.Heading}" FontSize="{StaticResource FontSize.DetailTitle}" FontWeight="SemiBold"
                   KeyDown="EditBox_KeyDown">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasTitleError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>

          <TextBlock Text="{x:Static res:Strings.Description}" Style="{StaticResource Field.Label}" />
          <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="80" VerticalScrollBarVisibility="Auto" KeyDown="EditBox_KeyDown" />

          <TextBlock Text="{x:Static res:Strings.Project}" Style="{StaticResource Field.Label}" />
          <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProject}" />
          <TextBlock Text="{x:Static res:Strings.NewProjectHint}" Style="{StaticResource Text.Hint}" Margin="{StaticResource Gap.ProjectHint}" />
          <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewProjectBox_KeyDown" />

          <!-- プロジェクトの作業フォルダ（AI ジョブの cwd）。プロジェクトが選ばれているときだけ -->
          <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Static res:Strings.ProjectWorkingDirectory}" Style="{StaticResource Field.Label}" />
            <TextBox Text="{Binding ProjectWorkingDirectory, UpdateSourceTrigger=LostFocus}" KeyDown="EditBox_KeyDown" />
            <TextBlock Text="{x:Static res:Strings.ProjectWorkingDirectoryHint}" Style="{StaticResource Text.Hint}" />
          </StackPanel>

          <TextBlock Text="{x:Static res:Strings.Labels}" Style="{StaticResource Field.Label}" />
          <ItemsControl ItemsSource="{Binding Labels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected}" Style="{StaticResource Chip.Toggle}" Margin="{StaticResource Gap.Chip}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Static res:Strings.NewLabelHint}" Style="{StaticResource Text.Hint}" Margin="{StaticResource Gap.LabelHint}" />
          <TextBox Text="{Binding NewLabelName, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewLabelBox_KeyDown" />

          <TextBlock Text="{x:Static res:Strings.DueDate}" Style="{StaticResource Field.Label}" />
          <DatePicker SelectedDate="{Binding DueDate}" />

          <!-- 完了日時は読み取り専用。完了列を出ると CompletedAtText が null になり、ラベルごと消える -->
          <TextBlock Text="{x:Static res:Strings.CompletedAt}" Style="{StaticResource Field.Label}"
                     Visibility="{Binding CompletedAtText, Converter={StaticResource NullToVisibility}}" />
          <TextBlock Text="{Binding CompletedAtText}" Style="{StaticResource Text.Small}"
                     Visibility="{Binding CompletedAtText, Converter={StaticResource NullToVisibility}}" />

          <TextBlock Text="{x:Static res:Strings.Column}" Style="{StaticResource Field.Label}" />
          <ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedColumn}" />

          <!-- AI に任せる（仕様 §10）。子 VM に DataContext を切り替える -->
          <Border Style="{StaticResource Section.Header}">
            <TextBlock Text="{x:Static res:Strings.AiSection}" Style="{StaticResource Text.Section}" />
          </Border>
          <StackPanel DataContext="{Binding Ai}">
            <!-- 依頼ボタン。実行中・中断中・削除済みでは出さない -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{x:Static res:Strings.AiResearch}" Command="{Binding BeginResearchCommand}" Margin="{StaticResource Gap.Right.4}" />
              <Button Content="{x:Static res:Strings.AiExecute}" Command="{Binding BeginExecuteCommand}" />
            </StackPanel>

            <!-- 指示文の確認・編集 -->
            <Border Visibility="{Binding IsComposing, Converter={StaticResource BoolToVisibility}}"
                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" Padding="{StaticResource Pad.Box}" Margin="{StaticResource Gap.Top.2}">
              <StackPanel>
                <TextBlock Text="{Binding ComposingTitle}" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="120" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Gap.Top.1}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.Top.2}">
                  <Button Content="{x:Static res:Strings.AiCancel}" Command="{Binding CancelComposeCommand}" Style="{StaticResource Btn.Ghost}" Margin="{StaticResource Gap.Right.4}" />
                  <Button Content="{x:Static res:Strings.AiStart}" Command="{Binding ConfirmStartCommand}" Style="{StaticResource Btn.Primary}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 最新ジョブの状態・結果・成果物・進行状況 -->
            <StackPanel Visibility="{Binding HasJob, Converter={StaticResource BoolToVisibility}}" Margin="{StaticResource Gap.Top.2}">
              <DockPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" FontWeight="Medium" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Prose}" Foreground="{StaticResource Brush.Danger}"
                         Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

              <TextBlock Text="{x:Static res:Strings.AiResult}" Style="{StaticResource Field.Label}"
                         Visibility="{Binding ResultText, Converter={StaticResource NullToVisibility}}" />
              <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200"
                       VerticalScrollBarVisibility="Auto"
                       Visibility="{Binding ResultText, Converter={StaticResource NullToVisibility}}" />

              <TextBlock Text="{x:Static res:Strings.AiArtifacts}" Style="{StaticResource Field.Label}" />
              <ItemsControl ItemsSource="{Binding Artifacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding FileName}" ToolTip="{Binding Path}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left"
                            Command="{Binding DataContext.OpenArtifactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{x:Static res:Strings.AiNoArtifacts}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Artifacts.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <!-- 操作（仕様 §11）。MoTask は端末のプロセスを所有しないので、殺すボタンは無い -->
              <TextBlock Text="{x:Static res:Strings.AiOperations}" Style="{StaticResource Field.Label}" />
              <!-- 実行系の枠付きボタン。Gap.Action は右だけでなく下も開けるので、
                   幅が足りずに折り返しても 2 行目が密着しない。 -->
              <WrapPanel Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{x:Static res:Strings.AiReopenTerminal}" Command="{Binding ReopenTerminalCommand}"
                        Margin="{StaticResource Gap.Action}" />
                <Button Content="{x:Static res:Strings.AiComplete}" Command="{Binding CompleteCommand}"
                        Style="{StaticResource Btn.Primary}" Margin="{StaticResource Gap.Action}" />
                <Button Content="{x:Static res:Strings.AiStopTracking}" Command="{Binding StopTrackingCommand}"
                        Margin="{StaticResource Gap.Action}" />
              </WrapPanel>
              <TextBlock Text="{x:Static res:Strings.AiStopTrackingHint}" Style="{StaticResource Text.Hint}"
                         Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}}" />
              <!-- 「開く」系は文字リンク。枠付きボタンと同じ行に混ぜると見た目が 3 種類そろって
                   騒がしいので、行を分けて左端をラベルに揃えた縦並びにする。 -->
              <StackPanel Margin="{StaticResource Gap.Top.2}">
                <Button Content="{x:Static res:Strings.AiOpenJobFolder}" Command="{Binding OpenJobFolderCommand}"
                        Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" />
                <Button Content="{x:Static res:Strings.AiOpenWorkingDirectory}" Command="{Binding OpenWorkingDirectoryCommand}"
                        Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" />
              </StackPanel>

              <TextBlock Text="{x:Static res:Strings.AiProgress}" Style="{StaticResource Field.Label}" />
              <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="{StaticResource Gap.Bottom.1}">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Text.Caption}" Width="64" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding Text}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Prose}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <Border Style="{StaticResource Section.Header}">
            <TextBlock Text="{x:Static res:Strings.History}" Style="{StaticResource Text.Section}" />
          </Border>
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Prose}" Margin="{StaticResource Gap.Bottom.1}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
