<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MoTask.App\MoTask.App.csproj" />
    <ProjectReference Include="..\..\src\MoTask.Core\MoTask.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!--
      BoardView.xaml を読めるようにする。ビューを実体化するテストは書けない
      （Application を作ると BoardViewModel/MorningPlanViewModel の
      「Application があるなら UI スレッドのはず」という Debug.Assert を壊す）ので、
      マークアップの配線はテキストとして確かめる。
    -->
    <None Include="..\..\src\MoTask.App\Views\BoardView.xaml" Link="Fixtures\BoardView.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- ラベルの見本の色がテーマにあるかを、同じくテキストとして確かめる -->
    <None Include="..\..\src\MoTask.App\Themes\Industry.xaml" Link="Fixtures\Industry.xaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
